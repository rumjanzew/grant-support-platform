DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=grantsupport.ru,www.grantsupport.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://grantsupport.ru,https://www.grantsupport.ru
FRONTEND_URL=https://grantsupport.ru
VITE_YANDEX_METRIKA_ID=112039500

POSTGRES_DB=grant_support
POSTGRES_USER=grant_support
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
